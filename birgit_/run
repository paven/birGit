#!/usr/bin/env bash
set -e
birgit_="$(dirname "$0")"
hash="$("$birgit_/hash" HEAD)"
tmpdir="$(mktemp -d -t "birgit-${hash}-XXX")"

cleanup() {
    git worktree remove --force "$tmpdir" 2>/dev/null || true
    rm -rf "$tmpdir"
}
trap cleanup EXIT

git worktree add "$tmpdir" &>/dev/null
(cd "$tmpdir" && "$@")
