#!/usr/bin/env bash
set -e

offset=0  # how many tags back to start (0 = latest)
count=1   # number of tags to show

for i in "$@"; do
    case $i in
        -n*)  count="${i#*n}"  ;;
        -b*)  offset="${i#*b}" ;;
        --help)
            echo "-n<N>  number of tags to show (default: 1)"
            echo "-b<N>  offset from latest tag, 0 is newest (default: 0)"
            exit 0
            ;;
    esac
done

tail_count=$(( offset + count ))
git for-each-ref \
    --format='%(*committerdate:raw)%(committerdate:raw) %(refname) %(*objectname) %(objectname)' \
    refs/tags \
    | sort -n \
    | awk '{ print $3 }' \
    | tail "-${tail_count}" \
    | head "-${count}"
