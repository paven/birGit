#!/usr/bin/env bash
set -e
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
default_branch="${default_branch:-master}"

if [ "$#" -gt 0 ]; then
    for branch in "$@"; do
        echo "$branch"
    done
else
    git branch -r --merged "origin/$default_branch" \
        | grep "origin/" \
        | grep -v "origin/$default_branch" \
        | grep -v "origin/HEAD" \
        | sed 's|^[[:space:]]*||'
fi
