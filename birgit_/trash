#!/usr/bin/env bash
set -e
trash_method=$(git config birgit.trash 2>/dev/null || true)

if [ "$trash_method" != "full" ]; then
    echo 'trash: stash only. Run `git config birgit.trash full` to enable hard reset + clean.' >&2
fi

git stash push -m trash

if [ "$trash_method" = "full" ]; then
    git reset --hard HEAD
    git clean -d -f -f
fi
