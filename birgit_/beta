#!/usr/bin/env bash
set -e
birgit_="$(dirname "$0")"

if [ -n "$1" ]; then
    cmd="$birgit_/beta_/$1"
    if [ -x "$cmd" ]; then
        "$cmd" "${@:2}"
    else
        echo "beta: not a valid command: $1" >&2
        "$birgit_/beta"
        exit 1
    fi
else
    find "$birgit_/beta_" -maxdepth 1 -perm -111 -type f -exec basename {} \; | sort
fi
