#!/usr/bin/env bash
set -e
birgit_="$(dirname "$0")"
target_commit="$("$birgit_/hash" "${1:-HEAD}")"

# No pending fixups or squashes in the range
if "$birgit_/commitMessageExists" "$target_commit" "fixup!" 2>/dev/null; then
    echo "amend: fixup! commit exists in range — run git rebase --autosquash first" >&2
    exit 1
fi
if "$birgit_/commitMessageExists" "$target_commit" "squash!" 2>/dev/null; then
    echo "amend: squash! commit exists in range — run git rebase --autosquash first" >&2
    exit 1
fi

# Target and its parent must be in HEAD's history
"$birgit_/contains" "$target_commit" > /dev/null
"$birgit_/contains" "${target_commit}^" > /dev/null

# Target must not be on shared remote history
if "$birgit_/shared" "$target_commit" > /dev/null 2>&1; then
    echo "amend: cannot rewrite shared history on origin/master" >&2
    exit 1
fi

git commit --fixup="$target_commit"
GIT_SEQUENCE_EDITOR="cat" git rebase "${target_commit}^" -i --autosquash --autostash --rebase-merges
