#!/usr/bin/env bash
set -e

n="-n10"

for i in "$@"; do
    case $i in
        --help)
            echo "Pretty git log with graph and timestamps. Accepts standard git log arguments."
            echo "  -n<N>  show N commits (default: 10)"
            exit 0
            ;;
        -n*)
            n=""
            ;;
    esac
    args="${args} ${i}"
done

# shellcheck disable=SC2086
git -c color.ui=always --no-pager log \
    $args \
    --graph \
    --decorate \
    --topo-order \
    $n \
    --pretty=format:'%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
